# Copy this file to `.env` for local development. Liara injects these in prod.

# App
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Comma-separated allowed origins, or * for any (fine for local dev).
CORS_ORIGIN=*

# Bearer token for the admin analytics/submissions endpoints (min 16 chars).
ADMIN_API_KEY=dev_admin_key_change_me_please
# Salt for hashing respondent IPs — privacy (min 16 chars). Use a random value.
IP_HASH_SALT=dev_ip_hash_salt_change_me

# The connection string Prisma uses. In production, set this to the connection
# string Liara gives you for its managed PostgreSQL.
DATABASE_URL=postgresql://viso:viso_dev_password@localhost:5432/viso?schema=public

# Local PostgreSQL credentials (read by docker-compose.yml for the dev database).
POSTGRES_USER=viso
POSTGRES_PASSWORD=viso_dev_password
POSTGRES_DB=viso
