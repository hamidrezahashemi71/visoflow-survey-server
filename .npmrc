# Use a mirror reachable from Iran to avoid ETIMEDOUT against registry.npmjs.org.
# pnpm verifies every package against the integrity hashes in pnpm-lock.yaml,
# so pulling the same packages from a mirror is safe (content-addressed).
registry=https://registry.npmmirror.com

# Be patient and resilient on flaky connections.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
